{
  "name": "@peschmae/slidev-theme-fhnw",
  "version": "0.0.1",
  "type": "module",
  "description": "FHNW Slidev theme based on the official FHNW LaTeX Beamer template",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/peschmae/slidev-theme-fhnw.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "files": [
    "layouts",
    "components",
    "styles",
    "setup",
    "assets",
    "global-bottom.vue",
    "package.json"
  ],
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^53.0.0",
    "@iconify-json/game-icons": "^1.2.4"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "fonts": {
        "sans": "Inter",
        "serif": "Spectral",
        "mono": "Roboto Mono"
      }
    }
  }
}
